    <string name="about_credit">Brought to you by Feng Qi Shi. Made for playing your local music — free and ad-free. Use it if you like.</string>
    <string name="ai_button">AI intro</string>
    <string name="ai_intro_title">AI song intro</string>
    <string name="ai_intro_loading">Asking AI, please wait…</string>
    <string name="ai_section_background">[Song background]</string>
    <string name="ai_section_artist">[About the artist]</string>
    <string name="ai_section_lyrics">[Lyrics overview]</string>
    <string name="ai_section_header_background">Song background</string>
    <string name="ai_section_header_artist">About the artist</string>
    <string name="ai_section_header_lyrics">Lyrics overview</string>
    <string name="ai_intro_system_prompt">You are a music chat assistant inside a music player. Answer in relaxed, colloquial Chinese, like a friend chatting—use short sentences, no academic tone. Reply in exactly three paragraphs, each starting with 【歌曲背景】【演唱者介绍】【歌词简介】. If you\'re unsure, say so; never make things up. Keep all three paragraphs under 300 Chinese characters.</string>
    <string name="ai_intro_user_question">Please introduce the song "%1$s" (artist: %2$s). Paragraph 1: the song\'s background and style. Paragraph 2: about the artist. Paragraph 3: what the lyrics are about.</string>
    <string name="ai_intro_message_template">[System] %1$s

[Question] %2$s</string>
    <string name="ai_error_auth">AI service is misconfigured; please tell the admin</string>
    <string name="ai_error_rate">Too many questions, wait a minute</string>
    <string name="ai_error_bad_request">Content too long or badly formatted; please be brief</string>
    <string name="ai_error_server">AI is tired, try again later</string>
    <string name="ai_error_network">Network failed, check your connection and retry</string>
    <string name="ai_error_empty">AI returned nothing, try again later</string>
    <string name="ai_error_disabled">AI feature not configured</string>
    <string name="ai_lyrics_button">Explain lyrics with AI</string>
    <string name="ai_lyrics_title">Lyrics explanation</string>
    <string name="ai_lyrics_system_prompt">You are a lyrics-explaining assistant inside a music player. Explain in relaxed, colloquial Chinese, like a friend chatting—short sentences, no academic tone. Reply in three paragraphs starting with 【歌词大意】【值得注意的句子】【怎么唱好】: (1) what the whole song is about and how the mood moves; (2) pick two or three key lines and explain their meaning and craft; (3) give two practical sing-along tips such as breathing spots, diction, and emotional emphasis. Don\'t recite the full lyrics, don\'t invent song facts, and say so when unsure.</string>
    <string name="ai_lyrics_user_question">Please explain the lyrics of "%1$s" (artist: %2$s). Lyrics:
%3$s</string>
    <string name="ai_lyrics_user_question_no_text">I don\'t have the original lyrics for "%1$s" (artist: %2$s) right now. Based on what you know, describe roughly what the song is about and how the mood flows, then give two tips for singing it. Never invent specific lyric lines; say so when unsure.</string>
